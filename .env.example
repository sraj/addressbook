# ── Database ──────────────────────────────────────────────
# Driver: sqlite3 (dev) or postgres (prod)
DATABASE_DRIVER=sqlite3
DATABASE_PATH=kern-addressbook.db
# For postgres (requires docker-compose up):
# DATABASE_DRIVER=postgres
# DATABASE_PATH=postgres://addressbook:addressbook@localhost:5432/addressbook?sslmode=disable

# ── Server ────────────────────────────────────────────────
ADDR=:8080
JWT_SECRET=kern-addressbook-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true in production so auth cookies use the Secure flag
# SECURE_COOKIE=true

# ── Observability ─────────────────────────────────────────
# OTLP endpoint for traces + metrics (Fluent Bit collector, see resources/logging/)
OTLP_ENDPOINT=localhost:4318

# ── Email (Mailgun or SendGrid) ───────────────────────────
# MAIL_PROVIDER=sendgrid
# MAIL_API_KEY=your_api_key
# MAIL_FROM=noreply@yourdomain.com
# MAIL_FROM_NAME="Address Book"
# APP_URL=http://localhost:5173

# Mailgun also needs:
# MAIL_DOMAIN=mg.yourdomain.com

# ── Stripe ────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
